# Copy this file to .env.local and fill in what you have.
# The app runs in a degraded-but-functional mode when any of these are missing:
# - no Supabase vars: public pages + /demo work, auth-gated pages show a
#   "backend not configured" state instead of crashing.
# - no AI key: explanations fall back to a deterministic template instead
#   of calling a model. Eligibility itself never depends on AI.
# - no Stripe keys: app runs in free/demo mode, billing UI is inert.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Create a free project at https://supabase.com, then Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Never import in client components.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that get role=admin auto-assigned on first signup.
# Convenience bootstrap only — every real authorization check reads the
# profiles.role column + RLS, not this env var. See docs/DATABASE.md.
ADMIN_EMAILS=

# --- AI explanation layer (optional) ---
# AI_PROVIDER selects the provider: "anthropic" | "openai" | unset (fallback).
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Billing (optional, test mode only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
